generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum ProposalType {
  SELLPROPERTY
  BUYPROPERTY
  USESAFETY
  USEREINVESTMENT
  REVENUETHRESHOLDCHANGE
  CHALLLENGEAUTHORITY
  REMOVEAUTHORITY
  PROPOSEREMOVEPROPOSAL
}

enum FundType {
  safety
  reinvestment
}

enum LeaseStatus {
  Active
  Terminated
  Expired
}

enum ReasonType {
  None
  Inactivity
  Other
  InvalidDocuments
  DuplicateIdentity
  Misconduct
  MaliciousVoting
  Fraud
  GovernanceDecision
}

enum ProposalStatus {
  Draft
  Active
  Passed
  Failed
  Rejected
  Executed
  Pending
  Approved
}

enum GovernmentType {
  COUNTRY
  STATE
}

enum AuthorityType {
  TRUSTEE
  ARBITRATOR
}

enum AccoutType {
  PROPERTY_SYSTEM
}

