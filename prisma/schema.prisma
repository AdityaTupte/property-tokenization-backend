model tranasction_history {
  id             String
  tranasction_id String
  account_type   AccoutType
  account_pubkey String

  // give refrences later

  @@unique([tranasction_id, account_pubkey])
}

model Signature {
  signature String @id
}

model User {
  fullName         String           @db.VarChar(100)
  username         String           @unique @db.VarChar(100)
  email            String           @unique @db.VarChar(100)
  avatar           String
  coverImage       String?
  password         String           @db.VarChar(100)
  id               String           @id @default(uuid())
  signer           String?          @unique
  refreshToken     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  candiateProfiles CandiateProfile?
}

model admin {
  user String @id
}

model CountryApprovalAuthority {
  id            Int      @id
  authority     String[]
  threshold     Int
  bump          Int
  created_time  DateTime @default(now())
  last_modified DateTime @updatedAt
}

model ApproveCountryAuthorityReceipt {
  id            String          @id @default(uuid())
  proposal_key  String
  approval_time DateTime        @default(now())
  signer        String
  bump          Int
  proposal      CountryProposal @relation(fields: [proposal_key], references: [proposal_public_key])

  @@unique([proposal_key, signer])
}

model CountryProposal {
  proposal_public_key             String                           @id
  total_authority                 Int
  country_id                      Int
  country_pda_threshold           Int
  country_name                    String
  approveCountryAuthorityReceipts ApproveCountryAuthorityReceipt[]
  approved                        Boolean
  executed                        Boolean
  proposal_bump                   Int
  proposal_created_time           DateTime                         @default(now())
}

model CountryPda {
  proposal_public_key     String                   @unique
  country_public_key      String                   @unique
  current_total_authority Int
  country_id              Int                      @id
  country_name            String                   @unique
  country_pda_threshold   Int
  total_authority         Int
  country_bump            Int
  authority               CountryAuthorityReceipt?
}

model CountryAuthorityReceipt {
  public_key   String          @id @default(uuid())
  created_time DateTime   @default(now())
  updated_time DateTime   @updatedAt
  signer       String[]
  country      CountryPda @relation(fields: [public_key], references: [country_public_key])
}

model ApproveStateAuthorityReceipt {
  id            Int      @id @default(autoincrement())
  proposal_key  String
  approval_time DateTime @default(now())
  signer        String
  bump          Int

  proposal StateProposal @relation(fields: [proposal_key], references: [proposal_public_key])

  @@unique([proposal_key, signer])
}

// model ApproveCountryAuthorityReceipt {
//   id            String          @id @default(uuid())
//   proposal_key  String
//   approval_time DateTime        @default(now())
//   signer        String
//   bump          Int
//   proposal      CountryProposal @relation(fields: [proposal_key], references: [proposal_public_key])

//   @@unique([proposal_key, signer])
// }

model StateProposal {
  proposal_public_key     String                         @unique
  state_id                Int
  state_name              String
  state_total_authorities Int
  country_pubkey          String
  approval                ApproveStateAuthorityReceipt[]
  approved                Boolean
  executed                Boolean
  proposal_bump           Int
  propsal_created_time    DateTime                       @default(now())

  @@id([proposal_public_key])
}

model StatePda {
  state_public_key          String                 @id
  proposal_public_key       String
  current_total_authority   Int
  state_id                  Int
  state_name                String
  state_total_authorities   Int
  state_authority_threshold Int
  country_pubkey            String
  state_bump                Int
  state_created_time        DateTime               @default(now())
  stateAuthorityReceipts    StateAuthorityReceipt?
}

model StateAuthorityReceipt {
  public_key         String   @id
  state_created_time DateTime @default(now())
  signer             String[]
  state              StatePda @relation(fields: [public_key], references: [state_public_key])
}

model PropertySystemAccount {
  creator_pubky              String
  property_system_id         Int
  property_system_public_key String            @id
  governance_mint            String            @unique
  threshold                  String            @unique
  treasury                   String            @unique
  reinvestment               String            @unique
  safety                     String            @unique
  dividend                   String            @unique
  trustee_registry           String            @unique
  arbitrator_registry        String            @unique
  total_properties           Int
  // total_token_supply         BigInt
  created_at                 DateTime
  ready_for_listing          Boolean
  bump                       Int
  dividendPdas               DividendPda[]
  trusteeRegistries          TrusteeRegistry?
  arbitrarRegistries         ArbitrarRegistry?
  thresholds                 Threshold?
  treasuries                 Treasury?
  propertyAccounts           PropertyAccount[]
  funds                      Fund[]
}

model DividendPda {
  dividend_pubkey     String                @id
  dividend_per_token  BigInt
  last_updated_ts     DateTime?
  bump                Int
  property_system_key PropertySystemAccount @relation(fields: [dividend_pubkey], references: [dividend])
}

model Trustees {
  public_key              String
  trustee_registry_pubkey String
  registry                TrusteeRegistry @relation(fields: [trustee_registry_pubkey], references: [trustee_registry_pubkey])

  @@id([public_key, trustee_registry_pubkey])
}

model Arbitrar {
  public_key               String
  arbitrar_registry_pubkey String
  registry                 ArbitrarRegistry @relation(fields: [arbitrar_registry_pubkey], references: [arbitrar_registry_pubkey])

  @@id([public_key, arbitrar_registry_pubkey])
}

model TrusteeRegistry {
  trustee_registry_pubkey    String                @id
  current_number_of_trustees Int
  total_trustees             Int
  vote_threshold             Int
  claim_deadline_ts          DateTime?
  total_salary_allocated     BigInt?
  bump                       Int
  property_system_key        PropertySystemAccount @relation(fields: [trustee_registry_pubkey], references: [trustee_registry])
  trustees                   Trustees[]
}

model ArbitrarRegistry {
  arbitrar_registry_pubkey   String                @id
  current_number_of_arbitrar Int
  total_arbitrar             Int
  vote_threshold             Int
  claim_deadline_ts          DateTime?             @default(now())
  total_salary_allocated     BigInt?
  bump                       Int
  property_system_key        PropertySystemAccount @relation(fields: [arbitrar_registry_pubkey], references: [arbitrator_registry])
  arbitrars                  Arbitrar[]
}

model Threshold {
  threshold_pub_key           String                @id
  trustee_salary_threshold    Int
  arbitrator_salary_threshold Int
  dividend_threshold          Int
  reinvestment_threshold      Int
  safety_threshold            Int
  property_system_key         PropertySystemAccount @relation(fields: [threshold_pub_key], references: [threshold])
}

model Treasury {
  treasury_key        String                @id
  last_distribution   DateTime?
  bump                Int
  property_system_key PropertySystemAccount @relation(fields: [treasury_key], references: [treasury])
}

model Fund {
  id                     String                @id @default(uuid())
  property_system_pubkey String
  fundKey                String
  fundtype               FundType
  used                   BigInt
  propertySystem         PropertySystemAccount @relation(fields: [property_system_pubkey], references: [property_system_public_key])

  @@unique([property_system_pubkey, fundtype])
}

enum ActionsHistory {
  None
  Inactivity
  Other
  InvalidDocuments
  DuplicateIdentity
  Misconduct
  MaliciousVoting
  Fraud
  GovernanceDecision
}

model CandiateProfile {
  candidate                  String               @id
  total_applied              Int
  total_selected_as_trustee  Int
  total_selected_as_arbitrar Int
  is_blacklisted             Boolean
  removal_count              Int
  actions_history            ActionsHistory[]
  metadata_hash              String
  bump                       Int
  user                       User                 @relation(fields: [candidate], references: [signer])
  authorityCandidates        AuthorityCandidate[]
}

model AuthorityCandidate {
  authority_candidate String              @unique
  candidate           String
  proposal            String
  selected            Boolean             @default(false)
  selected_time       DateTime            @default(now())
  vote_gained         BigInt
  is_finalized        Boolean
  authority_type      AuthorityType
  bump                Int
  candidate_profile   CandiateProfile     @relation(fields: [candidate], references: [candidate])
  votingForCandiates  VotingForCandiate[]

  @@id([candidate, proposal])
}

model PropertyProposal {
  property_id              Int
  proposal_property_pubkey String   @id
  property_system_pubkey   String
  state_pubkey             String
  legal_doc_hash           String
  issued_by                String
  approval_count           String[] 
  approved                 Boolean
  executed                 Boolean
  bump                     Int
}

model PropertyAccount {
  property_id         Int
  property_public_key String                @id
  is_leased           Boolean
  property_system     String
  history_of_owner    String[]
  state_id            Int
  state_pubkey        String
  country_id          Int
  country_pubkey      String
  issued_at           DateTime              @default(now())
  issued_by           String
  metadata            String
  bump                Int
  property_system_ref PropertySystemAccount @relation(fields: [property_public_key], references: [property_system_public_key])
}

model SalaryClaim {
  id             Int           @default(autoincrement())
  payer          String
  from           String
  authority_type AuthorityType
  receipt        String
  claim_time     DateTime      @default(now())
  amount         BigInt

  @@id([id, payer])
}

model PropertySellProposal {
  proposal_id         Int
  proposal_key        String    @id
  property_account    String
  sale_price          BigInt
  deposit_account_pda String
  transfer_deadline   DateTime
  proposal            Proposals @relation(fields: [proposal_key], references: [proposal_key])
}

model PropertyBuyProposal {
  id               Int      @default(autoincrement())
  proposal_id      Int
  proposal_key     String   @id
  buyer            String
  buyer_wallet     String
  sell_proposal    String
  property         String
  sale_price       Int
  payment_deadline DateTime
}

model Lease {
  property_system            String
  lease_id                   Int
  is_arbitrar_approved       Boolean
  arbitrar_approval_count    String[]
  initailized_at             DateTime    @default(now())
  property                   String
  lessee                     String
  periodic_pay               DateTime
  late_payment_fee_per_day   BigInt
  status                     LeaseStatus
  rent_amount                BigInt
  security_deposit           BigInt
  last_payement              DateTime
  agreemenbt_hash            String
  lessee_acceptance_deadline DateTime
  lease_end_time             DateTime
  neutral                    String
  bump                       Int

  @@id([lease_id, property])
}

model ChallengeProposal {
  creator                        String
  proposal_id                    Int
  proposal_key                   String     @id
  trustee_offender_total_number  String[]
  arbitrar_offender_total_number String[]
  required_vote_to_active        Int
  charges_hash                   String
  evidence                       String
  guilty                         ReasonType
  result_time                    DateTime
  index                          Int
  // ranking                        array
}

model RankCounter {
  proposal_id     String @id
  property_system String
  current_rank    Int
  bump            Int
}

model Offenders {
  id             Int           @default(autoincrement())
  offender_key   String[]
  proposal_key   String        @id
  authority_type AuthorityType
  is_finalized   Boolean
  bump           Int
  // challenge_proposal
}

model VotingForProposal {
  proposal_key String
  timestamp    DateTime
  signer       String
  voting_power BigInt

  @@id([proposal_key, signer])
}

model VotingForCandiate {
  proposal_key        String
  timestamp           DateTime
  signer              String
  to_whom             String
  authority_candidate AuthorityCandidate @relation(fields: [signer], references: [authority_candidate])

  @@id([proposal_key, signer])
}

model Resignation {
  id              Int            @default(autoincrement())
  authority       String[]
  proposal        String
  property_system String
  authority_type  AuthorityType
  time            DateTime       @default(now())
  status          ProposalStatus
  bump            Int

  @@unique([property_system, proposal, authority_type])
}

model RTChgProposal {
  new_threshold                    String
  proposal_id                      String   @id
  threshold_submission_deadline    DateTime
  voting_for_threshold_deadline    DateTime
  add_new_threshold_deadline       DateTime
  challenge_new_threshold_deadline DateTime
}

model NewThresholdProposal {
  property_system                 String
  new_threshold                   String
  proposal                        String @id
  signer                          String
  vote_gained                     String
  new_trustee_salary_threshold    Int
  new_arbitrator_salary_threshold Int
  new_dividend_threshold          Int
  new_reinvestment_threshold      Int
  new_safety_threshold            Int
  bump                            Int
}

model TokenTransferProposal {
  proposal_id      String   @id
  amount_required  BigInt
  reason_hash      String
  recepient_wallet String
  deadline         DateTime
}

model Elect {
  proposal_id                      String        @id
  total_authority_to_resign        Int
  authority_type                   AuthorityType
  is_initialized                   Boolean
  candidate_submission_deadline    DateTime
  voting_for_authority_deadline    DateTime
  add_new_authority_deadline       DateTime
  challenge_new_authority_deadline DateTime
  is_finalize                      Boolean
}

model Proposals {
  property_system       String
  proposal_id           String
  proposal_key          String                @id
  merkle_root           String
  arbitrar_approvals    String[]
  is_arbitrar_approved  Boolean
  total_voting_power    BigInt
  votes_for             BigInt // use  as vote gained in challenge proposal //rm_total_voting_power_gained
  votes_against         BigInt?
  vote_threshold        Int //use as rm_voting_threshold
  start_time            DateTime
  end_time              DateTime //use as  voting_deadline 
  status                ProposalStatus
  snapshot_submitted    Boolean
  proposal_type         ProposalType
  slot                  Int
  bump                  Int
  created_at            DateTime              @default(now())
  propertySellProposals PropertySellProposal?
}
